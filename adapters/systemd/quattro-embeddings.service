[Unit]
Description=Quattro local Nomic semantic embeddings

[Service]
Type=simple
ExecStart=%h/.local/share/quattro-ai/retrieval-models/llama-b10688/llama-b10688/llama-server --model %h/.local/share/quattro-ai/retrieval-models/nomic-embed-text-v1.5/nomic-embed-text-v1.5.Q4_K_M.gguf --alias nomic-embed-text-v1.5-q4_k_m --embedding --pooling mean --host 127.0.0.1 --port 20218 --ctx-size 2048 --batch-size 2048 --ubatch-size 2048 --parallel 1 --threads 4 --device none --offline --no-webui --no-slots --cors-origins localhost --no-cors-credentials --log-verbosity 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET
UMask=0077

[Install]
WantedBy=default.target
