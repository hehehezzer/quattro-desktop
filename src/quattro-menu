#!/usr/bin/env python3

from __future__ import annotations

import json
import os
import re
import shutil
import subprocess
import sys
import time
from collections import deque
from pathlib import Path


HOME = Path.home()
CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")).expanduser()
CACHE_HOME = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")).expanduser()
EDIT_TARGETS = {
    "hyprland": (CONFIG_HOME / "hypr/hyprland.lua", "hyprland"),
    "bindings": (CONFIG_HOME / "hypr/bindings.lua", "hyprland"),
    "ai": (CONFIG_HOME / "quattro/ai.json", "json"),
}
PACKAGE_TARGETS = {
    "code": "code",
    "docker": "docker",
    "gimp": "gimp",
    "blender": "blender",
    "obs": "obs-studio",
    "office": "libreoffice-fresh",
    "steam": "steam",
}
PACKAGE_NAME = re.compile(r"^[a-z0-9][a-z0-9@._+\-]*$")
SEARCH_CACHE = CACHE_HOME / "quattro/menu-search-index.json"
SEARCH_CACHE_MAX_AGE = 900
SEARCH_INDEX_LIMIT = 250_000
SEARCH_RESULT_LIMIT = 40
SEARCH_PRUNED_DIRECTORIES = {
    ".cache",
    ".aws",
    ".azure",
    ".docker",
    ".git",
    ".gnupg",
    ".kube",
    ".mozilla",
    ".password-store",
    ".ssh",
    ".Trash-1000",
    "__pycache__",
    "BraveSoftware",
    "chromium",
    "google-chrome",
    "node_modules",
    "quattro-ai",
}
SEARCH_PRUNED_FILE_NAMES = {
    "auth.json",
    "cookies",
    "credentials",
    "credentials.json",
    "login data",
    ".netrc",
    ".npmrc",
    ".pypirc",
}
IMAGE_SUFFIXES = {
    ".avif", ".bmp", ".gif", ".heic", ".jpeg", ".jpg", ".png", ".svg", ".tif", ".tiff", ".webp",
}
AUDIO_SUFFIXES = {".aac", ".flac", ".m4a", ".mp3", ".ogg", ".opus", ".wav"}
VIDEO_SUFFIXES = {".avi", ".m4v", ".mkv", ".mov", ".mp4", ".webm"}


def require(command: str) -> str:
    resolved = shutil.which(command)
    if resolved is None:
        raise RuntimeError(f"Required command is unavailable: {command}")
    return resolved


def run(command: list[str], **kwargs: object) -> subprocess.CompletedProcess[str]:
    return subprocess.run(command, check=False, text=True, **kwargs)


def validate_json(path: Path) -> tuple[bool, str]:
    try:
        json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as error:
        return False, str(error)
    return True, ""


def search_roots(home: Path = HOME) -> list[Path]:
    roots = [home]
    for path in (Path("/mnt/data-hdd"), Path("/mnt/data-ssd")):
        if path.is_dir():
            roots.append(path)
    return roots


def build_search_index(
    roots: list[Path] | None = None,
    limit: int = SEARCH_INDEX_LIMIT,
) -> list[list[object]]:
    entries: list[list[object]] = []
    selected_roots = [root for root in (roots if roots is not None else search_roots()) if root.is_dir()]
    if not selected_roots:
        return entries

    per_root_limit = max(1, limit // len(selected_roots))
    for root_index, root in enumerate(selected_roots):
        root_limit = per_root_limit
        if root_index == len(selected_roots) - 1:
            root_limit += limit - per_root_limit * len(selected_roots)
        root_entries = 0
        pending = deque([root])
        while pending and root_entries < root_limit:
            current = pending.popleft()
            try:
                children = sorted(os.scandir(current), key=lambda entry: entry.name.casefold())
            except OSError:
                continue
            for child in children:
                try:
                    is_directory = child.is_dir(follow_symlinks=False)
                except OSError:
                    is_directory = False
                if is_directory and child.name in SEARCH_PRUNED_DIRECTORIES:
                    continue
                if not is_directory and child.name.casefold() in SEARCH_PRUNED_FILE_NAMES:
                    continue
                entries.append([child.path, is_directory])
                root_entries += 1
                if is_directory:
                    pending.append(Path(child.path))
                if root_entries >= root_limit:
                    break
    return entries


def write_search_cache(entries: list[list[object]], path: Path = SEARCH_CACHE) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    temporary = path.with_suffix(f".tmp-{os.getpid()}")
    try:
        temporary.write_text(json.dumps(entries, separators=(",", ":")), encoding="utf-8")
        temporary.chmod(0o600)
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def load_search_index(
    roots: list[Path] | None = None,
    cache: Path = SEARCH_CACHE,
    max_age: int = SEARCH_CACHE_MAX_AGE,
) -> list[list[object]]:
    try:
        if time.time() - cache.stat().st_mtime <= max_age:
            parsed = json.loads(cache.read_text(encoding="utf-8"))
            if isinstance(parsed, list):
                return parsed
    except (OSError, ValueError):
        pass

    entries = build_search_index(roots)
    write_search_cache(entries, cache)
    return entries


def classify_search_result(path: Path, is_directory: bool) -> str:
    if is_directory:
        return "Directory"
    suffix = path.suffix.lower()
    if suffix in IMAGE_SUFFIXES:
        return "Image"
    if suffix in AUDIO_SUFFIXES:
        return "Audio"
    if suffix in VIDEO_SUFFIXES:
        return "Video"
    return "File"


def search_files(
    query: str,
    entries: list[list[object]] | None = None,
    limit: int = SEARCH_RESULT_LIMIT,
) -> list[dict[str, object]]:
    normalized = query.strip().casefold()
    if not normalized:
        return []

    matches: list[tuple[tuple[int, int, str], dict[str, object]]] = []
    for value in entries if entries is not None else load_search_index():
        if not isinstance(value, list) or len(value) != 2:
            continue
        raw_path, raw_is_directory = value
        if not isinstance(raw_path, str) or not isinstance(raw_is_directory, bool):
            continue
        path = Path(raw_path)
        name = path.name
        folded_name = name.casefold()
        folded_path = raw_path.casefold()
        if normalized not in folded_name and normalized not in folded_path:
            continue

        starts_with = 0 if folded_name.startswith(normalized) else 1
        name_match = 0 if normalized in folded_name else 1
        score = (starts_with + name_match, len(name), folded_path)
        display_path = str(path)
        try:
            display_path = "~/" + str(path.relative_to(HOME))
        except ValueError:
            pass
        matches.append((score, {
            "name": name,
            "path": raw_path,
            "displayPath": display_path,
            "kind": classify_search_result(path, raw_is_directory),
        }))

    matches.sort(key=lambda match: match[0])
    return [result for _, result in matches[:limit]]


def search_output(query: str) -> dict[str, object]:
    return {
        "schemaVersion": 1,
        "query": query,
        "results": search_files(query),
    }


def edit_target(target_id: str) -> int:
    target = EDIT_TARGETS.get(target_id)
    if target is None:
        print(f"Unknown setup target: {target_id}", file=sys.stderr)
        return 2

    path, validation = target
    if not path.is_file():
        print(f"Configuration file not found: {path}", file=sys.stderr)
        return 1

    result = run([require("nano"), str(path)])
    if result.returncode != 0:
        print("The editor exited without applying setup changes.", file=sys.stderr)
        return result.returncode

    if validation == "json":
        valid, message = validate_json(path)
        if not valid:
            print(f"Warning: {path.name} is not valid JSON: {message}", file=sys.stderr)
            return 1
        print(f"Validated {path.name}.")
        return 0

    reload_result = run([require("hyprctl"), "reload"])
    errors = run(
        [require("hyprctl"), "configerrors"],
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )
    output = (errors.stdout or "").strip()
    if reload_result.returncode == 0 and errors.returncode == 0 and not output:
        print("Hyprland reloaded with no configuration errors.")
        return 0

    print(output or "Hyprland reload failed.", file=sys.stderr)
    return 1


def resolve_package(package_id: str) -> str | None:
    if package_id == "custom":
        try:
            package = input("Official Arch package name: ").strip().lower()
        except EOFError:
            return None
    else:
        package = PACKAGE_TARGETS.get(package_id, "")

    if not PACKAGE_NAME.fullmatch(package):
        print("Package names may contain letters, numbers, @, ., _, +, and -.", file=sys.stderr)
        return None
    return package


def install_package(package_id: str) -> int:
    package = resolve_package(package_id)
    if package is None:
        return 2

    pacman = require("pacman")
    info = run(
        [pacman, "-Si", package],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if info.returncode != 0:
        print(f"{package} was not found in the enabled official repositories.", file=sys.stderr)
        return 1

    installed = run(
        [pacman, "-Q", package],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    if installed.returncode == 0:
        print(f"{package} is already installed.")
        return 0

    answer = input(f"Install {package} from the official Arch repositories? [y/N] ")
    if answer.strip().lower() not in {"y", "yes"}:
        print("Installation cancelled.")
        return 0

    return run([require("sudo"), pacman, "-S", "--needed", package]).returncode


def usage() -> None:
    print("Usage: quattro-menu edit TARGET | install PACKAGE | search QUERY")


def main(argv: list[str]) -> int:
    if len(argv) == 3 and argv[1] == "edit":
        return edit_target(argv[2])
    if len(argv) == 3 and argv[1] == "install":
        return install_package(argv[2])
    if len(argv) == 3 and argv[1] == "search":
        print(json.dumps(search_output(argv[2]), separators=(",", ":")))
        return 0
    usage()
    return 2


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv))
    except (OSError, RuntimeError) as error:
        print(f"quattro-menu: {error}", file=sys.stderr)
        raise SystemExit(1)
