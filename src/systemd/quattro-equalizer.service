[Unit]
Description=Quattro ten-band PipeWire equalizer
After=pipewire.service pipewire-pulse.service wireplumber.service
Requires=pipewire.service

[Service]
ExecStart=/usr/bin/python3 %h/.local/bin/quattro_desktop_controls.py eq supervise
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
