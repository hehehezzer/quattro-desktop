[Unit]
Description=Reconcile durable Quattro agent tasks and stale workers
After=default.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/quattro-agent task reconcile
TimeoutStartSec=30
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=%h/.config/quattro
ReadOnlyPaths=%h/.local/share/quattro-ai/codex/accounts
ReadWritePaths=%h/.local/state/quattro/agents
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=default.target
