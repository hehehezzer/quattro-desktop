[Unit]
Description=Surfshark VPN with Quattro location policy
After=graphical-session.target network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/Surfshark/surfshark --hidden
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=graphical-session.target
