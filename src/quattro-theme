def current_theme() -> str:
    try:
        data = json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
        name = data.get("theme")
        if name in THEMES:
            return name
    except (OSError, ValueError, TypeError):
        pass
    return DEFAULT_THEME


def write_theme(name: str) -> None:
    CONFIG_PATH.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".theme-", suffix=".json", dir=CONFIG_PATH.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            json.dump({"schemaVersion": 1, "theme": name}, handle, indent=2)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o644)
        os.replace(temporary, CONFIG_PATH)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def write_foot_theme(name: str) -> None:
    palette = FOOT_PALETTES[name]
    foot_color = lambda key: palette[key].removeprefix("#")
    lines = [
        "# Generated by quattro-theme. Do not edit this file directly.",
        f"# Active theme: {name}",
        "[colors-dark]",
        "alpha=1.0",
    ]
    # Foot uses regular0-7 and bright0-7 for the sixteen ANSI colors.
    for index in range(8):
        lines.append(f"regular{index}={foot_color(f'color{index}')}")
    for index in range(8):
        lines.append(f"bright{index}={foot_color(f'color{index + 8}')}")
    lines.extend([
        f"foreground={foot_color('foreground')}",
        f"background={foot_color('background')}",
        f"selection-foreground={foot_color('selection_foreground')}",
        f"selection-background={foot_color('selection_background')}",
        f"cursor={foot_color('cursor_text_color')} {foot_color('cursor')}",
        f"urls={foot_color('url_color')}",
    ])
    lines.append("")

    FOOT_THEME_PATH.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(
        prefix=".quattro-theme-",
        suffix=".ini",
        dir=FOOT_THEME_PATH.parent,
    )
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write("\n".join(lines))
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o644)
        os.replace(temporary, FOOT_THEME_PATH)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def write_ghostty_theme(name: str) -> None:
    palette = FOOT_PALETTES[name]
    lines = ["# Generated by quattro-theme. Do not edit this file directly.",
             f"# Active theme: {name}"]
    for key, palette_key in (("foreground", "foreground"), ("background", "background"),
                             ("selection-foreground", "selection_foreground"),
                             ("selection-background", "selection_background"),
                             ("cursor-color", "cursor"), ("cursor-text", "cursor_text_color")):
        lines.append(f"{key} = {palette[palette_key]}")
    for index in range(16):
        lines.append(f"palette = {index}={palette[f'color{index}']}")
    # Clear an old image when custom artwork is absent. Theme names come from
    # the fixed catalog, and the config value is quoted without allowing lines.
    artwork = WALLPAPER_DIR / f"{name}.png"
    image_path = str(artwork) if artwork.is_file() else ""
    if any(character in image_path for character in ("\n", "\r", "\x00")):
        image_path = ""
    escaped = image_path.replace("\\", "\\\\").replace('"', '\\"')
    lines.append(f'background-image = "{escaped}"')
    GHOSTTY_THEME_PATH.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".quattro-theme-", dir=GHOSTTY_THEME_PATH.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write("\n".join(lines) + "\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o644)
        os.replace(temporary, GHOSTTY_THEME_PATH)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def reload_ghostty() -> None:
    # Reload only verified Ghostty windows through its documented keyboard action.
    # Never signal the terminal process or close its shell.
    try:
        result = subprocess.run(["hyprctl", "clients", "-j"], text=True,
                                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                timeout=2, check=False)
        clients = json.loads(result.stdout) if result.returncode == 0 else []
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
        return
    for client in clients:
        if not isinstance(client, dict):
            continue
        address = str(client.get("address") or "")
        try:
            executable = (Path("/proc") / str(int(client.get("pid") or 0)) / "exe").resolve(strict=True)
        except (OSError, ValueError):
            continue
        if executable.name != "ghostty" or not re.fullmatch(r"0x[0-9a-fA-F]+", address):
            continue
        try:
            code = ('hl.dsp.send_shortcut({ mods = "CTRL SHIFT", key = "comma", '
                    f'window = "address:{address}"' + ' })')
            subprocess.run(["hyprctl", "dispatch", code],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                           timeout=2, check=False)
        except (OSError, subprocess.SubprocessError):
            continue


def reload_foot() -> None:
    # Standalone Foot windows and Foot server clients both reload on SIGUSR1.
    for process_name in ("foot", "footclient"):
        subprocess.run(
            ["pkill", "-USR1", "-x", process_name],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2,
            check=False,
        )


def apply_hyprland(name: str) -> None:
    active, inactive = HYPR_BORDERS[name]
    code = (
        "hl.config({ general = { border_size = 1, col = { "
        f'active_border = "{active}", inactive_border = "{inactive}"'
        " } }, decoration = { rounding = 0 } })"
    )
    subprocess.run(
        ["hyprctl", "eval", code],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=2,
        check=False,
    )


def main() -> int:
    action = sys.argv[1] if len(sys.argv) > 1 else "current"

    if action == "list":
        print("\n".join(THEMES))
        return 0
    if action == "current":
        print(current_theme())
        return 0
    if action == "next":
        active = current_theme()
        name = THEMES[(THEMES.index(active) + 1) % len(THEMES)]
    elif action == "set" and len(sys.argv) == 3 and sys.argv[2] in THEMES:
        name = sys.argv[2]
    else:
        print("usage: quattro-theme list|current|next|set THEME", file=sys.stderr)
        return 2

    write_foot_theme(name)
    write_ghostty_theme(name)
    write_theme(name)
    apply_hyprland(name)
    reload_foot()
    reload_ghostty()
    print(name)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
