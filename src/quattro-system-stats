#!/usr/bin/env python3

"""Small display-safe CPU/RAM monitor for the Quickshell bar."""

from __future__ import annotations

import json
import signal
import sys
import time
from pathlib import Path


PROC_STAT = Path("/proc/stat")
PROC_MEMINFO = Path("/proc/meminfo")
SCHEMA_VERSION = 1
DEFAULT_INTERVAL = 2.0


def read_cpu_times() -> tuple[int, int]:
    first = PROC_STAT.read_text(encoding="utf-8").splitlines()[0].split()
    if not first or first[0] != "cpu" or len(first) < 5:
        raise RuntimeError("aggregate CPU counters are unavailable")

    values = [int(value) for value in first[1:]]
    idle = values[3] + (values[4] if len(values) > 4 else 0)
    return sum(values), idle


def cpu_percent(previous: tuple[int, int], current: tuple[int, int]) -> float:
    total_delta = current[0] - previous[0]
    idle_delta = current[1] - previous[1]
    if total_delta <= 0:
        return 0.0
    return max(0.0, min(100.0, 100.0 * (total_delta - idle_delta) / total_delta))


def read_memory() -> tuple[int, int]:
    values: dict[str, int] = {}
    for line in PROC_MEMINFO.read_text(encoding="utf-8").splitlines():
        key, separator, remainder = line.partition(":")
        if not separator:
            continue
        token = remainder.strip().split()[0]
        if token.isdigit():
            values[key] = int(token) * 1024

    total = values.get("MemTotal", 0)
    available = values.get("MemAvailable", 0)
    if total <= 0 or available < 0:
        raise RuntimeError("memory counters are unavailable")
    return total - min(available, total), total


def snapshot(previous: tuple[int, int], current: tuple[int, int]) -> dict[str, object]:
    used, total = read_memory()
    return {
        "schemaVersion": SCHEMA_VERSION,
        "cpuPercent": round(cpu_percent(previous, current), 1),
        "ramPercent": round(100.0 * used / total, 1),
        "ramUsedBytes": used,
        "ramTotalBytes": total,
        "updatedAt": int(time.time()),
    }


def write_snapshot(value: dict[str, object]) -> None:
    print(json.dumps(value, separators=(",", ":")), flush=True)


def status() -> int:
    previous = read_cpu_times()
    time.sleep(0.12)
    write_snapshot(snapshot(previous, read_cpu_times()))
    return 0


def watch(interval: float) -> int:
    stopped = False

    def stop(_signum: int, _frame: object) -> None:
        nonlocal stopped
        stopped = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    previous = read_cpu_times()
    time.sleep(0.12)
    current = read_cpu_times()

    while not stopped:
        try:
            write_snapshot(snapshot(previous, current))
        except BrokenPipeError:
            return 0
        previous = current
        deadline = time.monotonic() + interval
        while not stopped and time.monotonic() < deadline:
            time.sleep(min(0.2, deadline - time.monotonic()))
        current = read_cpu_times()
    return 0


def main() -> int:
    action = sys.argv[1] if len(sys.argv) > 1 else "status"
    try:
        if action == "status" and len(sys.argv) == 2:
            return status()
        if action == "watch" and len(sys.argv) in (2, 3):
            interval = DEFAULT_INTERVAL if len(sys.argv) == 2 else float(sys.argv[2])
            if not 1.0 <= interval <= 60.0:
                raise ValueError("interval must be between 1 and 60 seconds")
            return watch(interval)
    except (OSError, RuntimeError, ValueError) as error:
        print(f"quattro-system-stats: {error}", file=sys.stderr)
        return 1

    print("usage: quattro-system-stats status|watch [SECONDS]", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
