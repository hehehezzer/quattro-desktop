#!/usr/bin/env python3
"""Read-only, bounded Linux metrics; JSON lines while the monitor page is open.

`status` emits an immediate first sample; rate fields are null until a second
sample. `watch [SECONDS]` keeps counters in memory, without a service or cache.
CPU percent uses aggregate/core tick deltas (guest ticks are not double counted).
Process CPU is percent of one core and may exceed 100 on multithreaded processes.
No command arguments, environments, network addresses, or credentials are read.
"""

from __future__ import annotations

import json
import math
import os
import re
import signal
import sys
import time
from pathlib import Path


SCHEMA_VERSION = 1
DEFAULT_INTERVAL = 2.0
READ_LIMIT = 65536
MAX_CORES = 512
MAX_PROCESSES = 2048
MAX_PROCESS_ENTRIES = 4096
PROCESS_BUDGET_SECONDS = 0.12
MAX_SENSORS = 32


def read_text(path: Path, limit: int = READ_LIMIT) -> str:
    with path.open("r", encoding="utf-8", errors="replace") as stream:
        return stream.read(limit)


def optional_text(path: Path, limit: int = READ_LIMIT) -> str | None:
    try:
        return read_text(path, limit)
    except (OSError, ValueError):
        return None


def number(path: Path) -> int | None:
    try:
        return int(read_text(path, 128).strip())
    except (OSError, ValueError):
        return None


def label(value: str, limit: int = 64) -> str:
    return "".join(character for character in value if character.isprintable())[:limit]


def percent(used: int, total: int) -> float | None:
    return round(max(0.0, min(100.0, 100.0 * used / total)), 1) if total > 0 else None


def cpu_counters(text: str) -> dict[str, tuple[int, int]]:
    result = {}
    for line in text.splitlines():
        fields = line.split()
        if not fields or not re.fullmatch(r"cpu(?:\d+)?", fields[0]):
            continue
        try:
            values = [int(value) for value in fields[1:9]]
            if len(values) < 4 or any(value < 0 for value in values):
                continue
            result[fields[0]] = (sum(values), values[3] + (values[4] if len(values) > 4 else 0))
        except ValueError:
            continue
        if len(result) >= MAX_CORES + 1:
            break
    return result


def cpu_delta(before: tuple[int, int] | None, after: tuple[int, int]) -> float | None:
    if before is None:
        return None
    total, idle = after[0] - before[0], after[1] - before[1]
    if total <= 0 or idle < 0 or idle > total:
        return None
    return percent(total - idle, total)


def memory_metrics(text: str) -> tuple[dict, dict]:
    values = {}
    for line in text.splitlines():
        fields = line.split()
        if len(fields) >= 2 and fields[1].isdigit():
            values[fields[0].rstrip(":")] = int(fields[1]) * 1024
    def metric(total_key: str, free_key: str) -> dict:
        total, free = values.get(total_key), values.get(free_key)
        if total is None or free is None or total < 0 or free < 0:
            return {"available": False, "totalBytes": None, "usedBytes": None,
                    "availableBytes": None, "percent": None}
        free = min(free, total)
        return {"available": True, "totalBytes": total, "usedBytes": total - free,
                "availableBytes": free, "percent": percent(total - free, total)}
    return metric("MemTotal", "MemAvailable"), metric("SwapTotal", "SwapFree")


def network_counters(text: str) -> dict[str, tuple[int, int]]:
    result = {}
    for line in text.splitlines():
        name, separator, counters = line.partition(":")
        fields = counters.split()
        if not separator or name.strip() == "lo" or len(fields) < 16:
            continue
        try:
            received, sent = int(fields[0]), int(fields[8])
            if received >= 0 and sent >= 0:
                result[label(name.strip())] = received, sent
        except ValueError:
            continue
        if len(result) >= 32:
            break
    return result


def network_metrics(current: dict, previous: dict | None, elapsed: float | None) -> dict:
    interfaces = []
    for name, counters in sorted(current.items()):
        rates = [None, None]
        old = previous.get(name) if previous is not None else None
        if old is not None and elapsed is not None and elapsed > 0:
            rates = [round((new - prior) / elapsed, 1) if new >= prior else None
                     for new, prior in zip(counters, old)]
        interfaces.append({"name": name, "rxBytesPerSecond": rates[0], "txBytesPerSecond": rates[1]})
    def total(key: str) -> float | None:
        return round(sum(item[key] for item in interfaces), 1) if (
            interfaces and all(item[key] is not None for item in interfaces)) else None
    return {"available": True, "rxBytesPerSecond": total("rxBytesPerSecond"),
            "txBytesPerSecond": total("txBytesPerSecond"), "interfaces": interfaces}


def process_stat(text: str, page_size: int) -> tuple[str, int, int, int] | None:
    # comm is parenthesized and can contain spaces or parentheses.
    left, right = text.find("("), text.rfind(")")
    if left < 0 or right <= left:
        return None
    fields = text[right + 1:].split()  # fields[0] is kernel field 3, state.
    try:
        if fields[0] in ("Z", "X", "x"):
            return None  # Exited/zombie processes have no active address space.
        ticks = int(fields[11]) + int(fields[12])
        start, rss = int(fields[19]), int(fields[21]) * page_size
        if min(ticks, start, rss) < 0:
            return None
        return label(text[left + 1:right]), ticks, start, rss
    except (ValueError, IndexError):
        return None


class Sampler:
    def __init__(self, proc: Path = Path("/proc"), sysfs: Path = Path("/sys")) -> None:
        self.proc, self.sysfs = proc, sysfs
        self.previous_cpu: dict = {}
        self.previous_network: dict | None = None
        self.previous_processes: dict = {}
        self.previous_time: float | None = None
        self.page_size = os.sysconf("SC_PAGE_SIZE")
        self.ticks_per_second = os.sysconf("SC_CLK_TCK")

    def filesystem(self) -> dict:
        try:
            info = os.statvfs("/")
            total, free, available = (info.f_blocks * info.f_frsize,
                                      info.f_bfree * info.f_frsize,
                                      info.f_bavail * info.f_frsize)
            return {"available": True, "mount": "/", "totalBytes": total,
                    "usedBytes": total - free, "availableBytes": available,
                    "percent": percent(total - free, total)}
        except OSError:
            return {"available": False, "mount": "/", "totalBytes": None,
                    "usedBytes": None, "availableBytes": None, "percent": None}

    def temperatures(self) -> dict:
        sensors = []
        try:
            zones = sorted((self.sysfs / "class/thermal").glob("thermal_zone*"))[:MAX_SENSORS]
            for zone in zones:
                value = number(zone / "temp")
                if value is not None and -40000 <= value <= 200000:
                    name = optional_text(zone / "type", 128) or zone.name
                    sensors.append({"name": label(name.strip()), "celsius": round(value / 1000, 1)})
            # hwmon exposes CPU/GPU sensors on machines without thermal zones.
            for device in sorted((self.sysfs / "class/hwmon").glob("hwmon*"))[:MAX_SENSORS]:
                name = label((optional_text(device / "name", 128) or device.name).strip())
                for path in sorted(device.glob("temp*_input"))[:MAX_SENSORS]:
                    if len(sensors) >= MAX_SENSORS:
                        break
                    value = number(path)
                    if value is not None and -40000 <= value <= 200000:
                        detail = optional_text(path.with_name(path.name.replace("_input", "_label")), 128)
                        sensors.append({"name": label(name + " · " + (detail or path.stem).strip()),
                                        "celsius": round(value / 1000, 1)})
        except OSError:
            pass
        return {"available": bool(sensors), "sensors": sensors}

    def gpu(self) -> dict:
        devices = []
        vendors = {"0x1002": "AMD", "0x10de": "NVIDIA", "0x8086": "Intel"}
        try:
            cards = sorted((self.sysfs / "class/drm").glob("card*"))[:32]
            for card in cards:
                if not re.fullmatch(r"card\d+", card.name):
                    continue
                device = card / "device"
                vendor = optional_text(device / "vendor", 128)
                if vendor is None:
                    continue
                busy = number(device / "gpu_busy_percent")
                used, total = number(device / "mem_info_vram_used"), number(device / "mem_info_vram_total")
                devices.append({"name": vendors.get(vendor.strip(), "GPU") + " · " + card.name,
                                "busyPercent": busy if busy is not None and 0 <= busy <= 100 else None,
                                "memoryUsedBytes": used if used is not None and used >= 0 else None,
                                "memoryTotalBytes": total if total is not None and total > 0 else None})
        except OSError:
            pass
        return {"available": bool(devices), "devices": devices}

    def processes(self, elapsed: float | None, cores: int, memory_total: int | None = None) -> dict:
        items, counters = [], {}
        scanned, omitted, truncated = 0, 0, False
        deadline = time.monotonic() + PROCESS_BUDGET_SECONDS
        try:
            with os.scandir(self.proc) as entries:
                for entry in entries:
                    scanned += 1
                    if scanned > MAX_PROCESS_ENTRIES or len(counters) >= MAX_PROCESSES or time.monotonic() > deadline:
                        truncated = True
                        break
                    if not entry.name.isdigit():
                        continue
                    text = optional_text(Path(entry.path) / "stat", 4096)
                    parsed = process_stat(text, self.page_size) if text else None
                    if parsed is None:
                        omitted += 1
                        continue
                    name, ticks, start, rss = parsed
                    pid, cpu = int(entry.name), None
                    before = self.previous_processes.get(pid)
                    if before is not None and before[1] == start and elapsed is not None and elapsed > 0:
                        delta = ticks - before[0]
                        if delta >= 0:
                            cpu = round(min(100.0 * max(1, cores), 100.0 * delta / self.ticks_per_second / elapsed), 1)
                    counters[pid] = ticks, start
                    items.append({"pid": pid, "name": name, "cpuPercent": cpu, "rssBytes": rss,
                                  "rssPercent": round(max(0.0, min(100.0, 100.0 * rss / memory_total)), 2) if memory_total else None})
        except OSError:
            self.previous_processes = {}
            return {"available": False, "truncated": False, "omittedCount": omitted,
                    "limit": MAX_PROCESSES, "items": []}
        self.previous_processes = counters
        # Stable resident-memory order avoids distracting two-second row jumps.
        items.sort(key=lambda item: (-item["rssBytes"], item["pid"]))
        return {"available": True, "truncated": truncated, "omittedCount": omitted,
                "limit": MAX_PROCESSES, "items": items}

    def sample(self) -> dict:
        now = time.monotonic()
        elapsed = now - self.previous_time if self.previous_time is not None else None
        cpu = cpu_counters(optional_text(self.proc / "stat") or "")
        cores = [{"id": key, "percent": cpu_delta(self.previous_cpu.get(key), value)}
                 for key, value in cpu.items() if key != "cpu"]
        cpu_value = {"available": "cpu" in cpu, "percent": cpu_delta(self.previous_cpu.get("cpu"), cpu["cpu"]) if "cpu" in cpu else None,
                     "cores": cores}
        memory, swap = memory_metrics(optional_text(self.proc / "meminfo") or "")
        net_text = optional_text(self.proc / "net/dev")
        net = network_counters(net_text) if net_text is not None else {}
        network = network_metrics(net, self.previous_network, elapsed) if net_text is not None else {
            "available": False, "rxBytesPerSecond": None, "txBytesPerSecond": None, "interfaces": []}
        try:
            uptime = float((optional_text(self.proc / "uptime", 128) or "").split()[0])
            uptime = round(uptime, 1) if math.isfinite(uptime) and uptime >= 0 else None
        except (ValueError, IndexError):
            uptime = None
        result = {"schemaVersion": SCHEMA_VERSION, "updatedAt": int(time.time()),
                  "cpu": cpu_value, "memory": memory, "swap": swap, "filesystem": self.filesystem(),
                  "uptimeSeconds": uptime, "network": network, "temperatures": self.temperatures(),
                  "gpu": self.gpu(), "processes": self.processes(elapsed, len(cores), memory["totalBytes"])}
        self.previous_cpu, self.previous_network, self.previous_time = cpu, net if net_text is not None else None, now
        return result


def main(argv: list[str] | None = None) -> int:
    args = sys.argv[1:] if argv is None else argv
    if not args or args == ["status"]:
        action, interval = "status", DEFAULT_INTERVAL
    elif len(args) in (1, 2) and args[0] == "watch":
        action = "watch"
        try:
            interval = float(args[1]) if len(args) == 2 else DEFAULT_INTERVAL
            if not math.isfinite(interval) or not 1.0 <= interval <= 60.0:
                raise ValueError
        except ValueError:
            print("quattro-monitor: interval must be between 1 and 60 seconds", file=sys.stderr)
            return 2
    else:
        print("usage: quattro-monitor status|watch [SECONDS]", file=sys.stderr)
        return 2
    stopped = False
    def stop(_signum: int, _frame: object) -> None:
        nonlocal stopped
        stopped = True
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    sampler = Sampler()
    try:
        while not stopped:
            started = time.monotonic()
            print(json.dumps(sampler.sample(), separators=(",", ":"), allow_nan=False), flush=True)
            if action == "status":
                break
            deadline = started + interval
            while not stopped and time.monotonic() < deadline:
                time.sleep(max(0.0, min(0.1, deadline - time.monotonic())))
    except BrokenPipeError:
        return 0
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
